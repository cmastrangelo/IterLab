# Copy to .env and adjust. All variables are prefixed with ITERLAB_.
# Keep values comment-free (no trailing "# ..." on the same line).

# --- Security (REQUIRED) --------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
ITERLAB_JWT_SECRET=change-me

# --- Database -----------------------------------------------------------
# Bundled PostgreSQL (docker compose --profile bundled-db up):
#   leave ITERLAB_DATABASE_URL UNSET — compose points the api at the
#   "postgres" service automatically.
# External PostgreSQL, or running the backend outside docker:
#   set ITERLAB_DATABASE_URL below.
# ITERLAB_DATABASE_URL=postgresql+asyncpg://iterlab:iterlab@localhost:5432/iterlab

# Schema IterLab owns (created if missing; lets it share a database).
ITERLAB_DB_SCHEMA=iterlab
# Create schema + tables on startup (dev). Use Alembic in production.
ITERLAB_DB_AUTO_CREATE=true

# --- Redis (queues / coordination) --------------------------------------
# Bundled: leave UNSET (compose uses the "redis" service). External: set it.
# ITERLAB_REDIS_URL=redis://localhost:6379/0

# --- Artifact storage --------------------------------------------------
ITERLAB_STORAGE_BACKEND=filesystem
ITERLAB_STORAGE_PATH=./data/artifacts

# --- Tokens / sessions -----------------------------------------------
# seconds: 900 = 15 min, 2592000 = 30 days
ITERLAB_ACCESS_TOKEN_TTL=900
ITERLAB_REFRESH_TOKEN_TTL=2592000

# --- HTTP ------------------------------------------------------------
ITERLAB_CORS_ORIGINS=http://localhost:3000
ITERLAB_ENV=development

# --- Runs -----------------------------------------------------------
# Per-run spend cap (USD). A run pauses before its next step once accumulated
# agent cost hits this; resume from the UI to add budget. 0 disables the cap.
ITERLAB_RUN_BUDGET_USD=2.0

# --- Instance config (deployment-specific labs; see instance.example/) --
# ITERLAB_INSTANCE_DIR is set by docker-compose to /app/instance.
# Outside docker it defaults to ./instance when that directory exists.

# --- Bundled PostgreSQL credentials (only with --profile bundled-db) ----
POSTGRES_USER=iterlab
POSTGRES_PASSWORD=iterlab
POSTGRES_DB=iterlab
