# Copy to .env and adjust. All variables are prefixed with ITERLAB_.

# ---------------------------------------------------------------------------
# Security (REQUIRED)
# ---------------------------------------------------------------------------
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ITERLAB_JWT_SECRET=change-me

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Option A — use the bundled PostgreSQL from docker-compose:
#   docker compose --profile bundled-db up
#   (compose sets DATABASE_URL for the api service automatically)
#
# Option B — use an existing/external PostgreSQL: set the URL here and start
#   compose WITHOUT the bundled-db profile.
ITERLAB_DATABASE_URL=postgresql+asyncpg://iterlab:iterlab@localhost:5432/iterlab

# Schema that IterLab owns. Created automatically if missing. Lets IterLab
# share a database with other applications without collisions.
ITERLAB_DB_SCHEMA=iterlab

# Create the schema and all tables on startup. Great for dev; in production
# prefer running Alembic migrations and setting this to false.
ITERLAB_DB_AUTO_CREATE=true

# ---------------------------------------------------------------------------
# Redis (queues / coordination)
# ---------------------------------------------------------------------------
ITERLAB_REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Artifact storage
# ---------------------------------------------------------------------------
ITERLAB_STORAGE_BACKEND=filesystem
ITERLAB_STORAGE_PATH=./data/artifacts

# ---------------------------------------------------------------------------
# Tokens / sessions
# ---------------------------------------------------------------------------
ITERLAB_ACCESS_TOKEN_TTL=900          # seconds (15 min)
ITERLAB_REFRESH_TOKEN_TTL=2592000     # seconds (30 days)

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
ITERLAB_CORS_ORIGINS=http://localhost:3000
ITERLAB_ENV=development                # development | production

# ---------------------------------------------------------------------------
# Bundled PostgreSQL credentials (only used with --profile bundled-db)
# ---------------------------------------------------------------------------
POSTGRES_USER=iterlab
POSTGRES_PASSWORD=iterlab
POSTGRES_DB=iterlab
